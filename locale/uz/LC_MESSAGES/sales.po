msgid ""
"Synchronize (Lazada to Odoo) all confirmed orders (:abbr:`FBM (Fulfilled By "
"Merchant)`) with status :guilabel:`READY_TO_SHIP` or :guilabel:`PROCESSED`, "
"including:"
msgstr ""
":guilabel:`READY_TO_SHIP` yoki :guilabel:`PROCESSED` holatidagi barcha "
"tasdiqlangan buyurtmalarni (:abbr:`FBM (Fulfilled By Merchant)`) (Lazada'dan "
"Odoo'ga) sinxronlashtirish, jumladan:"

#: ../../content/applications/sales/sales/lazada_connector/features.rst:18
#: ../../content/applications/sales/sales/shopee_connector.rst:18
msgid "Product name"
msgstr "Mahsulot nomi"

#: ../../content/applications/sales/sales/lazada_connector/features.rst:19
#: ../../content/applications/sales/sales/shopee_connector.rst:19
msgid "SKU reference"
msgstr "SKU havolasi"

#: ../../content/applications/sales/sales/lazada_connector/features.rst:20
#: ../../content/applications/sales/sales/shopee_connector.rst:20
msgid "Quantity"
msgstr "Miqdor"

#: ../../content/applications/sales/sales/lazada_connector/features.rst:22
msgid ""
"Synchronize (Odoo to Lazada) all available product quantities (:abbr:`FBM "
"(Fulfilled By Merchant)`)."
msgstr ""
"Barcha mavjud mahsulot miqdorlarini sinxronlashtiring (Odoo'dan Lazada'ga) "
"(:abbr:`FBM (Fulfilled By Merchant)`)."

#: ../../content/applications/sales/sales/lazada_connector/features.rst:25
msgid ""
"Synchronize the Lazada product catalog into Odoo or map existing Odoo "
"products to Lazada SKUs."
msgstr ""
"Lazada mahsulot katalogini Odoo'ga sinxronlashtiring yoki mavjud Odoo "
"mahsulotlarini Lazada SKU'lariga bog'lang."

