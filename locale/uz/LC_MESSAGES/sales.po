msgstr ""
":guilabel:`Opportunities`: Imkoniyat sifatida saralangan lidlarni ko'rsatadi."

#: ../../content/applications/sales/crm/performance/win_loss.rst:79
msgid ""
":guilabel:`Leads`: Show leads that have yet to be qualified as opportunities."
msgstr ""
":guilabel:`Leads`: Hali imkoniyat sifatida saralanmagan lidlarni ko'rsatadi."

