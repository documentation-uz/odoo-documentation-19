msgstr "Zaxira sozlamalarida partiya va seriya raqamlarini yoqing."

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/removal_strategies/fifo.rst:None
#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/removal_strategies/lifo.rst:None
msgid "Enable tracking by serial number."
msgstr "Seriya raqami bo'yicha kuzatuvni yoqing."

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/removal_strategies/fifo.rst:47
#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/removal_strategies/lifo.rst:44
