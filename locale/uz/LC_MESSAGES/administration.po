msgstr "Egalik huquqini o'tkazish"

#: ../../content/administration/odoo_online.rst:139
msgid ""
"Create a support ticket to request a database ownership transfer by "
"clicking :guilabel:`Transfer Ownership`."
msgstr ""
":guilabel:`Transfer Ownership` tugmasini bosish orqali ma'lumotlar bazasi "
"egalik huquqini o'tkazishni so'rash uchun qo'llab-quvvatlash tiketini "
