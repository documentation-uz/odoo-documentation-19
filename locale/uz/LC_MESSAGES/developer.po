msgstr ""
":doc:`Module yaratish bo'yicha qo'llanma <../tutorials/server_framework_101>`"

#: ../../content/developer/reference/external_api.rst:446
msgid ""
"PostgreSQL - Transaction Isolation - `Repeatable Read <https://"
"www.postgresql.org/docs/current/transaction-iso.html#XACT-REPEATABLE-READ>`_"
msgstr ""
"PostgreSQL - Transaction Isolation - `Repeatable Read <https://"
"www.postgresql.org/docs/current/transaction-iso.html#XACT-REPEATABLE-READ>`_"

