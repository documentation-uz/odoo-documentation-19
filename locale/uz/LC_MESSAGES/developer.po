#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1075
msgid "Performs a click sequence on the given `Target`."
msgstr "Berilgan `Target` ustida click ketma-ketligini bajaradi."

#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1077
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1132
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1152
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1170
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1186
