msgstr "command uchun icon bo'lib xizmat qiladigan *Font Awesome* nomi"

#: ../../content/developer/reference/frontend/odoo_editor.rst:189
msgid ""
"used to order the command: a command with a higher priority is displayed "
"higher into the Powerbox (commands with the same priority are ordered "
"alphabetically)"
msgstr ""
"command'larni tartiblash uchun ishlatiladi: yuqori priority'ga ega command "
"Powerbox'da yuqoriroqda ko'rsatiladi (bir xil priority'ga ega command'lar "
"alifbo tartibida joylashtiriladi)"

