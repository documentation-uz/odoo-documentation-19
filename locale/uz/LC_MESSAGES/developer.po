#: ../../content/developer/howtos/website_themes/building_blocks.rst:311
msgid "Text highlights"
msgstr "Matn ajratmalari (text highlights)"

#: ../../content/developer/howtos/website_themes/building_blocks.rst:313
msgid ""
"Text highlights are SVG files that can be incorporated onto specific words "
"or phrases to emphasize them. Text highlights offer customizable options for "
"colors and thickness."
msgstr ""
"Matn ajratmalari — aniq so'z yoki iboralarni ta'kidlash uchun ularga "
"qo'shiladigan SVG fayllardir. Matn ajratmalari rang va qalinlik uchun "
"sozlanadigan variantlarni taklif qiladi."

#: ../../content/developer/howtos/website_themes/building_blocks.rst:None
msgid "Example of text highlight"
msgstr "Matn ajratmasi misoli"

