msgstr "Java"

#: ../../content/developer/reference/external_rpc_api.rst:199
msgid ""
"These examples use the `Apache XML-RPC library <https://ws.apache.org/xmlrpc/"
">`_."
msgstr ""
"Bu misollarda `Apache XML-RPC library <https://ws.apache.org/xmlrpc/>`_ "
