msgid "``operator`` (``str``)"
msgstr "``operator`` (``str``)"

#: ../../content/developer/reference/backend/orm.rst:935
msgid ""
"an operator used to compare the ``field_expr`` with the ``value``. Valid "
"operators are:"
msgstr ""
