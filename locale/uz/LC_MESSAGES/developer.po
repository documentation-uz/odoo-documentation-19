msgstr "``=ilike`` (va ``not =ilike``)"

#: ../../content/developer/reference/backend/orm.rst:963
msgid "case insensitive ``=like``"
msgstr "harf registriga sezgir bo'lmagan ``=like``"

#: ../../content/developer/reference/backend/orm.rst:965
msgid "``in`` (and ``not in``)"
msgstr "``in`` (va ``not in``)"

#: ../../content/developer/reference/backend/orm.rst:965
msgid ""
