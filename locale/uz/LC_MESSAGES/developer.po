msgstr "`--text-highlight-width`"

#: ../../content/developer/howtos/website_themes/building_blocks.rst:343
msgid "Thickness of the SVG borders"
msgstr "SVG chegaralarining qalinligi"

#: ../../content/developer/howtos/website_themes/building_blocks.rst:344
