msgstr "``<``"

#: ../../content/developer/reference/backend/orm.rst:947
msgid "less than"
msgstr "kichik"

#: ../../content/developer/reference/backend/orm.rst:948
msgid "``<=``"
msgstr "``<=``"

#: ../../content/developer/reference/backend/orm.rst:949
msgid "less than or equal to"
msgstr "kichik yoki teng"

#: ../../content/developer/reference/backend/orm.rst:951
msgid "``=?``"
msgstr "``=?``"

#: ../../content/developer/reference/backend/orm.rst:951
msgid ""
"unset or equals to (returns true if ``value`` is either ``None`` or "
"``False``, otherwise behaves like ``=``)"
msgstr ""
"o'rnatilmagan yoki teng (agar ``value`` ``None`` yoki ``False`` bo'lsa true "
"qaytaradi, aks holda ``=`` kabi ishlaydi)"

#: ../../content/developer/reference/backend/orm.rst:955
msgid "``=like`` (and ``not =like``)"
msgstr "``=like`` (va ``not =like``)"

#: ../../content/developer/reference/backend/orm.rst:954
msgid ""
"matches ``field_expr`` against the ``value`` pattern. An underscore ``_`` in "
"the pattern stands for (matches) any single character; a percent sign ``%`` "
"matches any string of zero or more characters."
msgstr ""
"``field_expr`` ni ``value`` shabloniga moslashtiradi. Shablondagi tagchiziq "
"``_`` istalgan bitta belgini bildiradi (mos keladi); foiz belgisi ``%`` nol "
"yoki undan ko'p belgidan iborat istalgan satrga mos keladi."

#: ../../content/developer/reference/backend/orm.rst:958
msgid "``like`` (and ``not like``)"
msgstr "``like`` (va ``not like``)"

#: ../../content/developer/reference/backend/orm.rst:958
msgid ""
"matches ``field_expr`` against the ``%value%`` pattern. Similar to ``=like`` "
"but wraps ``value`` with '%' before matching"
msgstr ""
"``field_expr`` ni ``%value%`` shabloniga moslashtiradi. ``=like`` ga "
"o'xshash, lekin moslashtirishdan oldin ``value`` ni '%' bilan o'raydi"

#: ../../content/developer/reference/backend/orm.rst:960
msgid "``ilike`` (and ``not ilike``)"
msgstr "``ilike`` (va ``not ilike``)"

#: ../../content/developer/reference/backend/orm.rst:961
