#: ../../content/developer/reference/frontend/owl_components.rst:852
#: ../../content/developer/reference/frontend/owl_components.rst:855
#: ../../content/developer/reference/frontend/owl_components.rst:858
#: ../../content/developer/reference/frontend/owl_components.rst:1080
msgid "`number`"
msgstr "`number`"

#: ../../content/developer/reference/frontend/odoo_editor.rst:154
msgid ""
"used to order the category: a category with a higher priority is displayed "
"higher into the Powerbox (categories with the same priority are ordered "
"alphabetically)"
msgstr ""
"category'larni tartiblash uchun ishlatiladi: yuqori priority'ga ega category "
"Powerbox'da yuqoriroqda ko'rsatiladi (bir xil priority'ga ega category'lar "
"alifbo tartibida joylashtiriladi)"

#: ../../content/developer/reference/frontend/odoo_editor.rst:159
msgid ""
"If several categories exist with the same name, they will be grouped into "
"one. Its priority will be that defined in the version of the category that "
"was declared last."
msgstr ""
"Agar bir xil nomli bir nechta category mavjud bo'lsa, ular bittaga "
"birlashtiriladi. Uning priority'si eng oxirida e'lon qilingan category "
"variantida belgilangan qiymat bo'ladi."

#: ../../content/developer/reference/frontend/odoo_editor.rst:166
msgid "Command"
msgstr "Command"

#: ../../content/developer/reference/frontend/odoo_editor.rst:177
