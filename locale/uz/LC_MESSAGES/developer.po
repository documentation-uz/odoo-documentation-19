msgstr "int(), float()"

#: ../../content/developer/reference/backend/security.rst:592
#: ../../content/developer/reference/backend/security.rst:594
#: ../../content/developer/reference/backend/testing.rst:349
#: ../../content/developer/reference/backend/testing.rst:533
