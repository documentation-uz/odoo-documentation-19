msgstr "snippet-group"

#: ../../content/developer/howtos/website_themes/building_blocks.rst:516
msgid "ID of the group"
msgstr "Guruhning ID'si"

#: ../../content/developer/howtos/website_themes/building_blocks.rst:517
#: ../../content/developer/howtos/website_themes/building_blocks.rst:558
msgid "t-snippet"
msgstr "t-snippet"

#: ../../content/developer/howtos/website_themes/building_blocks.rst:518
