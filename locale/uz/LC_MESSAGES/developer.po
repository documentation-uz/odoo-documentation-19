msgid "The event sequence is as follows:"
msgstr "Event ketma-ketligi quyidagicha:"

#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1079
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1154
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1203
msgid "`pointerdown`"
msgstr "`pointerdown`"

#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1080
#: ../../content/developer/reference/frontend/unit_testing/hoot.rst:1155
