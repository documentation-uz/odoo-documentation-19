#: ../../content/applications/finance/fiscal_localizations/peru.rst:814
#: ../../content/applications/finance/fiscal_localizations/peru.rst:835
msgid ":guilabel:`Tax ID Number`"
msgstr ":guilabel:`Tax ID Number`"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:None
msgid "Individual type operator configurations in the Contact form."
msgstr "Kontakt formasidagi jismoniy shaxs turidagi operator sozlamalari."

#: ../../content/applications/finance/fiscal_localizations/peru.rst:822
msgid ""
"The *carrier* is used when the delivery guide is through *public* transport."
msgstr ""
"*Tashuvchi* yetkazib berish yo'riqnomasi *ommaviy* transport orqali "
"bo'lganda ishlatiladi."

#: ../../content/applications/finance/fiscal_localizations/peru.rst:824
msgid ""
"To create a new carrier, navigate to :menuselection:`Contacts --> Create` "
"and fill out the contact information."
msgstr ""
"Yangi tashuvchi yaratish uchun :menuselection:`Contacts --> Create` yo'lidan "
"o'ting va kontakt ma'lumotlarini to'ldiring."

#: ../../content/applications/finance/fiscal_localizations/peru.rst:827
msgid ""
"First, select :guilabel:`Company` as the :guilabel:`Company Type`. Then, add "
"the :guilabel:`MTC Registration Number`, :guilabel:`Authorization Issuing "
"Entity`, and the :guilabel:`Authorization Number`."
msgstr ""
"Avval :guilabel:`Company Type` sifatida :guilabel:`Company` ni tanlang. "
"So'ngra :guilabel:`MTC Registration Number`, :guilabel:`Authorization "
"Issuing Entity` va :guilabel:`Authorization Number` ni qo'shing."

#: ../../content/applications/finance/fiscal_localizations/peru.rst:831
msgid "For the company address, make sure the following fields are complete:"
msgstr ""
"Kompaniya manzili uchun quyidagi maydonlar to'ldirilganligiga ishonch hosil "
"qiling:"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:None
msgid "Company type operator configurations in the Contact form."
msgstr "Kontakt formasidagi kompaniya turidagi operator sozlamalari."

