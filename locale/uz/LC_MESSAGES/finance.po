msgstr ""
"Sotuv jarayonida ombordan yetkazib berish yaratilgach, o'tkazma formasining "
"yuqori o'ng qismidagi |GRE| maydonlarini to'ldirganingizga ishonch hosil "
"qiling:"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:876
msgid ":guilabel:`Transport Type`"
msgstr ":guilabel:`Transport Type`"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:877
