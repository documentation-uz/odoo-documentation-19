msgstr "HTML"

#: ../../content/applications/productivity/ai/fields.rst:39
msgid "Integer"
msgstr "Butun son"

#: ../../content/applications/productivity/ai/fields.rst:40
msgid "Decimal"
msgstr "O'nlik son"

#: ../../content/applications/productivity/ai/fields.rst:41
msgid "Monetary"
msgstr "Pul qiymati"

